Screen {
    background: $background;
    layout: vertical;
}
Header {
    background: $primary;
    padding: 1;
    height: auto;
    text-style: bold;
    color: $text;
}

Header .header-title {
    width: 100%;
    height: auto;
    text-style: bold;
}

.status-container {
    width: 100%;
    height: auto;
    padding: 1;
    background: $panel;
    margin-bottom: 1;
    margin-top: 1;
}

.status-grid {
    width: 100%;
    height: auto;
    grid-size: 2 1;
    grid-gutter: 2;
    grid-rows: auto;
    align: left top;
}

.status-card {
    width: 100%;
    height: auto;
    min-height: 0;
    background: $panel;
    padding: 1 1;
    border: round outer $panel;
}

.status-card-title {
    text-style: bold;
    margin: 0 0;
}

.status-card-indicator {
    margin: 0 0;
}

.status-on {
    background: #166534;
    color: #22c55e;
    border: #166534;
}

.status-off {
    background: #991b1b;
    border: #991b1b;
    color: #ef4444;
}

.status-pending {
    background: #9a3412;
    border: #9a3412;
    color: #f97316;
}

.status-btn {
    width: 100%;
}

.main-tabs {
    width: 100%;
    height: 1fr;
    padding: 1;
    background: $panel;
}

StatusItem {
    layout: vertical;
    width: 100%;
    height: auto;
    align: left top;
    padding: 1 1;
}
StatusItem.striped {
    background: $surface;
}
StatusItem .status-item-label {
    width: auto;
    height: auto;
    text-style: bold;
}

StatusItem .status-item-content {
    width: 1fr;
    height: auto;
    color: $text-muted;
}

.status-item-btn{
    width: 100%;
    align: left top;
    border: tall;
    
}

FileEditorScreen {
    align: center middle;
}

#file-editor-dialog {
    width: 90%;
    height: 90%;
    border: round $primary;
    background: $surface;
    padding: 1 2;
}

#file-editor-title {
    height: auto;
    margin-bottom: 1;
    text-style: bold;
}

#file-editor {
    height: 1fr;
}

#file-editor-actions {
    height: auto;
    margin-top: 1;
    align-horizontal: right;
}

#file-editor-actions Button {
    margin-left: 1;
}

Divider {
    width: 100%;
    height: 1;
    background: $surface;
}

Divider.horizontal {
    width: 100%;
}

Divider.vertical {
    width: 1;
    height: 100%;
}
FgItem{
    keyline: red;
    padding: 1 1;
    border: green;
}
.fg-items{
    keyline: thin #ff6363;
}
.fg-item-content {
    height: auto;
}
.fg-item-title{
    text-style: bold;
}

.fg-item-subtitle{
    color: $text-muted;
}
.ini-editor-screen{
    height: 100%;
    padding: 1 1;
    border: round;
}

.ini-editor-title{
    width: 100%;
    height: auto;
    background: $primary;
    padding: 1 1;
    margin-bottom: 1;
}
.ini-editor-content{
    border: round;
    height: 1fr;
}
.ini-editor-textarea{
    height: 100%;
}
.ini-editor-actions{
    width: 100%;
    height: auto;
}