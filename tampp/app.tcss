Screen {
    background: $background;
    layout: vertical;
}

Header {
    background: $primary;
    padding: 1;
    height: auto;
    text-style: bold;
    color: $text;
}

Header .header-title {
    width: 100%;
    height: auto;
    text-style: bold;
}

Footer {
    background: $accent;
    # padding: 1;
    height: auto;
    text-style: bold;
    color: $text;
}

.status-container {
    width: 100%;
    height: auto;
    padding: 1;
    background: $panel;
    margin-bottom: 1;
    margin-top: 1;
}

.status-grid {
    width: 100%;
    height: auto;
    grid-size: 2 1;
    grid-gutter: 2;
    grid-rows: auto;
    align: left top;
}

.status-card {
    width: 100%;
    height: auto;
    min-height: 0;
    background: $panel;
    padding: 1 1;
    border: round outer $panel;
}

.status-card-title {
    text-style: bold;
    margin: 0 0;
}

.status-card-indicator {
    margin: 0 0;
}

.status-on {
    background: #166534;
    color: #22c55e;
    border: #166534;
}

.status-off {
    background: #991b1b;
    border: #991b1b;
    color: #ef4444;
}

.status-pending {
    background: #9a3412;
    border: #9a3412;
    color: #f97316;
}

.status-btn {
    width: 100%;
}

.main-tabs {
    width: 100%;
    height: 1fr;
    padding: 1;
    background: $panel;
}

ListGroup {
    width: 100%;
    height: auto;
    background: $surface;
    padding: 0;
    border: tall $panel;
}

ListGroup ListView {
    width: 100%;
    height: auto;
}

.list-group-title {
    width: 100%;
    color: $primary;
    text-style: bold;
    padding-left: 1;
    padding-right: 1;
    content-align: left bottom;
}

ListGroupItem {
    width: 100%;
    height: auto;
    padding: 1;
    margin: 0;
    min-height: 0;
    transition: background 150ms, border 150ms;
}

ListGroupItem:last-child {
    border-bottom: none;
}

ListGroupItem:odd {
    background: $boost;
}

ListGroupItem:even {
    background: $surface;
}

ListGroupItem.pressed {
    background: $primary-darken-2;
}

ListGroupItem .item-content {
    width: 100%;
    height: auto;
    padding: 0;
}

ListGroupItem .item-title {
    width: 100%;
    height: auto;
    color: $text;
    text-style: bold;
}

ListGroupItem .item-subtitle {
    width: 100%;
    height: auto;
    color: $text-muted;
}

ListGroupItem .item-url {
    width: 100%;
    height: auto;
    color: $accent;
    text-style: underline;
}

ListGroupItem .item-path {
    width: 100%;
    height: auto;
    color: $accent;
    text-style: underline;
}

.code-editor-container {
    height: 1fr;
    padding: 0 1;
}

.code-editor-path {
    width: 100%;
    height: auto;
    padding: 0 1;
    background: $surface;
    margin: 1 0;
}

.code-editor-textarea {
    height: 1fr;
}

.code-editor-actions {
    layout: grid;
    width: 100%;
    height: auto;
    grid-size: 2;
    grid-columns: 1fr auto;
    margin: 1 0;
    content-align: center middle;
}

.code-editor-actions .buttons-container {
    layout: grid;
    width: 100%;
    height: auto;
    grid-size: 2;
    grid-gutter: 1;
    grid-columns: auto;
}

.code-editor-status {
    height: 100%;
    padding: 0 1;
    color: $text-muted;
    content-align: center middle;
}

.btn {
    padding: 0;
    margin: 0;
    height: auto;
}

.footer-bar {
    dock: bottom;
    width: 100%;
    height: auto;
    background: $secondary;
}